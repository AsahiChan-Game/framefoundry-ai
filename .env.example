# FrameFoundry AI 只读取本地配置；复制为 .env 后按需修改。
# Web 控制台默认访问 http://127.0.0.1:8766/api。
FRAMEFOUNDRY_LTX_URL=http://127.0.0.1:8188
FRAMEFOUNDRY_H3_URL=http://127.0.0.1:8189
FRAMEFOUNDRY_SEEDVR_URL=http://127.0.0.1:8190
FRAMEFOUNDRY_NTSC_URL=http://127.0.0.1:8191
FRAMEFOUNDRY_MUSIC_URL=http://127.0.0.1:8192

# 可选：默认保存到项目 data/ 目录。
# FRAMEFOUNDRY_DATA_DIR=C:/FrameFoundry/data
# FRAMEFOUNDRY_OUTPUT_DIR=C:/FrameFoundry/outputs
# FRAMEFOUNDRY_UPLOAD_DIR=C:/FrameFoundry/uploads

# 可选：成片库只会扫描这些明确配置的本地目录；Windows 多目录使用分号分隔。
# FRAMEFOUNDRY_LIBRARY_ROOTS=C:/AI-Videos/production;D:/Old-Renders
# 可选：读取既有 video_generation_history.sqlite3，原数据库保持只读。
# FRAMEFOUNDRY_HISTORY_DATABASE=C:/AI-Videos/production/video_generation_history.sqlite3
# 可选：把 ComfyUI 返回的文件名解析为可直接播放的本地文件。
# FRAMEFOUNDRY_H3_OUTPUT_DIR=C:/AI/ComfyUI-H3/ComfyUI/output

# 真实 ComfyUI 任务最长等待秒数，默认一小时。
FRAMEFOUNDRY_REAL_JOB_TIMEOUT_SECONDS=3600

# 参考素材上限，默认 20 MiB。
FRAMEFOUNDRY_MAX_REFERENCE_BYTES=20971520
